# ── Pick ONE provider. Ollama needs no key and no credit card. ────────────────
#
# The whole repo runs on any of these. Chapter 01 explains the tradeoffs.

DATAAGENT_PROVIDER=ollama          # ollama | anthropic | openai | azure

# ── Ollama (free, local, no signup) ───────────────────────────────────────────
# Install: https://ollama.com  then:  ollama pull qwen2.5:3b
#
# PICK A MODEL THAT FITS IN YOUR GPU MEMORY. This matters more than which model
# you choose. If it doesn't fit, Ollama spills onto the CPU and speed collapses
# — measured on an 8 GB M2, llama3.1:8b managed about one token every eleven
# seconds, which makes chapter 03 take roughly an hour. The 3B model on the same
# machine is fine.
#
# Model choice matters as much as size. Measured here with
# scripts/compare_models.py (2 questions x 3 runs, 8 GB M2):
#
#   qwen2.5:3b    83% correct, 100% grounded,  4s   1.9 GB  ← recommended
#   qwen2.5:7b    67% correct, 100% grounded, 25s   5.2 GB  (spills to CPU here)
#   llama3.2:3b   17% correct,  50% grounded, 12s   2.0 GB  (emits tool calls as text)
#
# Same size, wildly different tool-calling ability. Benchmark before you trust:
#   python scripts/compare_models.py --runs=3
#
# Check what you have:  ollama ps   (shows CPU/GPU split for a loaded model)
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434

# ── Anthropic ─────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# claude-opus-5      $5 / $25 per million tokens   (most capable)
# claude-sonnet-5    $3 / $15                      (good balance)
# claude-haiku-4-5   $1 / $5                       (cheapest, fine for ch01-04)
ANTHROPIC_MODEL=claude-opus-5

# ── OpenAI ────────────────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── Azure OpenAI (Azure AI Foundry) ───────────────────────────────────────────
# Uses the OpenAI-compatible /openai/v1 surface, so `model` is your *deployment*
# name and no api-version is needed. Paste the endpoint from Keys and Endpoint;
# a trailing sample path like /openai/v1/responses is trimmed automatically.
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.services.ai.azure.com/openai/v1
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# ── Agent safety rails (chapter 07 explains every one of these) ───────────────
DATAAGENT_MAX_STEPS=12             # hard cap on agent loop iterations
DATAAGENT_MAX_USD=0.50             # abort the run if it costs more than this
DATAAGENT_SQL_ROW_LIMIT=1000       # rows any single query may return
DATAAGENT_TIMEOUT_S=600            # seconds to wait on one model call
