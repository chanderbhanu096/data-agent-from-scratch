# ── Pick ONE provider. Ollama needs no key and no credit card. ────────────────
#
# The whole repo runs on any of these. Chapter 01 explains the tradeoffs.

DATAAGENT_PROVIDER=ollama          # ollama | anthropic | openai

# ── Ollama (free, local, no signup) ───────────────────────────────────────────
# Install: https://ollama.com  then:  ollama pull llama3.2:3b
#
# PICK A MODEL THAT FITS IN YOUR GPU MEMORY. This matters more than which model
# you choose. If it doesn't fit, Ollama spills onto the CPU and speed collapses
# — measured on an 8 GB M2, llama3.1:8b managed about one token every eleven
# seconds, which makes chapter 03 take roughly an hour. The 3B model on the same
# machine is fine.
#
#   ~8 GB RAM   → llama3.2:3b        (2 GB, the safe default)
#   ~16 GB RAM  → llama3.1:8b        (4.9 GB, better at tool calling)
#   ~32 GB+     → qwen2.5:14b        (9 GB, best local results)
#
# Check what you have:  ollama ps   (shows CPU/GPU split for a loaded model)
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

# ── Anthropic ─────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# claude-opus-5      $5 / $25 per million tokens   (most capable)
# claude-sonnet-5    $3 / $15                      (good balance)
# claude-haiku-4-5   $1 / $5                       (cheapest, fine for ch01-04)
ANTHROPIC_MODEL=claude-opus-5

# ── OpenAI ────────────────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── Agent safety rails (chapter 07 explains every one of these) ───────────────
DATAAGENT_MAX_STEPS=12             # hard cap on agent loop iterations
DATAAGENT_MAX_USD=0.50             # abort the run if it costs more than this
DATAAGENT_SQL_ROW_LIMIT=1000       # rows any single query may return
DATAAGENT_TIMEOUT_S=600            # seconds to wait on one model call
